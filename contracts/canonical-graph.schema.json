{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonicalGraphSnapshot",
  "type": "object",
  "required": [
    "schema_version",
    "repository_id",
    "revision",
    "nodes",
    "edges",
    "coverage",
    "issues"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "repository_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 0 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/FileNode" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/DependencyEdge" }
    },
    "coverage": { "$ref": "#/definitions/AnalysisCoverage" },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/definitions/AnalysisIssue" }
    },
    "insights": { "$ref": "#/definitions/ArchitecturalInsights" }
  },
  "definitions": {
    "FileNode": {
      "type": "object",
      "required": ["id", "relative_path", "filename", "language", "analysis_status"],
      "properties": {
        "id": { "type": "string" },
        "relative_path": { "type": "string" },
        "filename": { "type": "string" },
        "language": { "type": "string" },
        "size_bytes": { "type": "integer" },
        "file_kind": { "type": "string" },
        "analysis_status": {
          "type": "string",
          "enum": ["Pending", "Analyzed", "PartiallyAnalyzed", "Excluded", "Failed", "Unsupported"]
        },
        "direct_dependency_count": { "type": "integer" },
        "direct_dependent_count": { "type": "integer" }
      }
    },
    "DependencyEdge": {
      "type": "object",
      "required": ["id", "source_file_id", "target_file_id", "relationship_kind", "resolution_status", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "source_file_id": { "type": "string" },
        "target_file_id": { "type": "string" },
        "relationship_kind": {
          "type": "string",
          "enum": ["Import", "Export", "DynamicImport", "TypeOnly"]
        },
        "resolution_status": {
          "type": "string",
          "enum": ["ResolvedInternal", "ExternalPackage", "Unresolved", "Unsupported"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/DependencyEvidence" }
        }
      }
    },
    "DependencyEvidence": {
      "type": "object",
      "required": ["source_file_id", "import_specifier", "line", "column", "relationship_kind"],
      "properties": {
        "source_file_id": { "type": "string" },
        "import_specifier": { "type": "string" },
        "line": { "type": "integer" },
        "column": { "type": "integer" },
        "relationship_kind": { "type": "string" },
        "is_type_only": { "type": "boolean" }
      }
    },
    "AnalysisCoverage": {
      "type": "object",
      "required": ["total_discovered", "total_analyzed", "total_excluded", "total_issues", "is_complete"],
      "properties": {
        "total_discovered": { "type": "integer" },
        "total_analyzed": { "type": "integer" },
        "total_excluded": { "type": "integer" },
        "total_issues": { "type": "integer" },
        "is_complete": { "type": "boolean" }
      }
    },
    "AnalysisIssue": {
      "type": "object",
      "required": ["file_path", "issue_kind", "message"],
      "properties": {
        "file_path": { "type": "string" },
        "issue_kind": { "type": "string" },
        "message": { "type": "string" },
        "line": { "type": ["integer", "null"] },
        "column": { "type": ["integer", "null"] }
      }
    },
    "CycleGroup": {
      "type": "object",
      "required": ["id", "files", "example_cycle", "is_type_only", "edge_count"],
      "properties": {
        "id": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "example_cycle": { "type": "array", "items": { "type": "string" } },
        "is_type_only": { "type": "boolean" },
        "edge_count": { "type": "integer" },
        "classification": {
          "type": "string",
          "enum": ["RuntimeRelevant", "TypeOnly", "MixedStructural"]
        }
      }
    },
    "HighlyDependedFile": {
      "type": "object",
      "required": ["file_id", "relative_path", "dependent_count", "dependency_count"],
      "properties": {
        "file_id": { "type": "string" },
        "relative_path": { "type": "string" },
        "dependent_count": { "type": "integer" },
        "dependency_count": { "type": "integer" }
      }
    },
    "ConnectedArea": {
      "type": "object",
      "required": ["area_id", "outbound_count", "inbound_count"],
      "properties": {
        "area_id": { "type": "string" },
        "outbound_count": { "type": "integer" },
        "inbound_count": { "type": "integer" }
      }
    },
    "AreaCoupling": {
      "type": "object",
      "required": ["area_id", "file_count", "analyzed_file_count", "internal_edge_count", "outbound_edge_count", "inbound_edge_count", "connected_areas"],
      "properties": {
        "area_id": { "type": "string" },
        "file_count": { "type": "integer" },
        "analyzed_file_count": { "type": "integer" },
        "internal_edge_count": { "type": "integer" },
        "outbound_edge_count": { "type": "integer" },
        "inbound_edge_count": { "type": "integer" },
        "connected_areas": { "type": "array", "items": { "$ref": "#/definitions/ConnectedArea" } }
      }
    },
    "DiagnosticsSummary": {
      "type": "object",
      "required": ["total_discovered", "total_analyzed", "total_partially_analyzed", "total_unsupported", "total_failed", "total_unresolved_imports", "total_issues"],
      "properties": {
        "total_discovered": { "type": "integer" },
        "total_analyzed": { "type": "integer" },
        "total_fully_analyzed": { "type": "integer" },
        "total_partially_analyzed": { "type": "integer" },
        "total_unsupported": { "type": "integer" },
        "total_failed": { "type": "integer" },
        "total_unresolved_imports": { "type": "integer" },
        "total_issues": { "type": "integer" }
      }
    },
    "DependencyPath": {
      "type": "object",
      "required": ["nodes", "edges", "hops", "is_type_only"],
      "properties": {
        "nodes": { "type": "array", "items": { "type": "string" } },
        "edges": { "type": "array", "items": { "$ref": "#/definitions/DependencyEdge" } },
        "hops": { "type": "integer" },
        "is_type_only": { "type": "boolean" }
      }
    },
    "DependencyPathResult": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["found", "not_found", "same_file", "missing_endpoint"] },
        "path": { "$ref": "#/definitions/DependencyPath" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "file_id": { "type": "string" },
        "hops": { "type": "integer" },
        "missing_file_id": { "type": "string" }
      }
    },
    "ArchitecturalInsights": {
      "type": "object",
      "required": ["cycle_groups", "total_cycle_files", "highly_depended_files", "area_couplings", "diagnostics_summary"],
      "properties": {
        "cycle_groups": { "type": "array", "items": { "$ref": "#/definitions/CycleGroup" } },
        "total_cycle_files": { "type": "integer" },
        "highly_depended_files": { "type": "array", "items": { "$ref": "#/definitions/HighlyDependedFile" } },
        "area_couplings": { "type": "array", "items": { "$ref": "#/definitions/AreaCoupling" } },
        "diagnostics_summary": { "$ref": "#/definitions/DiagnosticsSummary" }
      }
    }
  }
}

